diff --git a/overlay/rootfs/usr/local/bin/mechos-gpu-setup b/overlay/rootfs/usr/local/bin/mechos-gpu-setup
index 5a85a88..7da18e9 100755
--- a/overlay/rootfs/usr/local/bin/mechos-gpu-setup
+++ b/overlay/rootfs/usr/local/bin/mechos-gpu-setup
@@ -1,14 +1,42 @@
 #!/usr/bin/env bash
 set -Eeuo pipefail
 if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi
+
+# Add the nvidia-drm.modeset=1 kernel param regardless of bootloader. MechOS
+# doesn't pin a single bootloader (archinstall can leave GRUB or systemd-boot),
+# so handle both and no-op cleanly if neither is present.
+add_nvidia_modeset_param() {
+  if command -v grub-mkconfig >/dev/null 2>&1 && [[ -f /etc/default/grub ]]; then
+    if ! grep -q 'nvidia-drm.modeset=1' /etc/default/grub; then
+      sed -i -E 's/^(GRUB_CMDLINE_LINUX_DEFAULT="[^"]*)"/\1 nvidia-drm.modeset=1"/' /etc/default/grub
+      grub-mkconfig -o /boot/grub/grub.cfg || true
+    fi
+  elif command -v bootctl >/dev/null 2>&1 && [[ -d /boot/loader/entries ]]; then
+    for entry in /boot/loader/entries/*.conf; do
+      [[ -f "$entry" ]] || continue
+      grep -q 'nvidia-drm.modeset=1' "$entry" || sed -i '/^options /s/$/ nvidia-drm.modeset=1/' "$entry"
+    done
+  else
+    echo "[MechOS] No recognized bootloader (grub/systemd-boot) found; skipping nvidia-drm.modeset kernel param." >&2
+  fi
+}
+
+pacman -Sy --noconfirm
+
 if lspci 2>/dev/null | grep -qi nvidia; then
   echo "[MechOS] NVIDIA GPU detected"
-  dnf -y install akmod-nvidia xorg-x11-drv-nvidia-cuda || {
-    echo "[MechOS] NVIDIA packages unavailable. Check RPM Fusion/nonfree and network." >&2
+  pacman -S --needed --noconfirm nvidia-open nvidia-utils nvidia-settings lib32-nvidia-utils || {
+    echo "[MechOS] NVIDIA packages unavailable. Check network/mirrors and multilib." >&2
     exit 1
   }
-  grubby --update-kernel=ALL --args='nvidia-drm.modeset=1' || true
+  add_nvidia_modeset_param
+elif lspci 2>/dev/null | grep -qiE 'amd|radeon'; then
+  echo "[MechOS] AMD graphics path"
+  pacman -S --needed --noconfirm mesa vulkan-radeon vulkan-tools lib32-mesa lib32-vulkan-radeon || true
+elif lspci 2>/dev/null | grep -qi intel; then
+  echo "[MechOS] Intel graphics path"
+  pacman -S --needed --noconfirm mesa vulkan-intel vulkan-tools lib32-mesa lib32-vulkan-intel || true
 else
-  echo "[MechOS] AMD/Intel graphics path"
-  dnf -y install mesa-dri-drivers mesa-vulkan-drivers vulkan-tools || true
+  echo "[MechOS] Could not identify GPU vendor from lspci; installing generic mesa/vulkan-tools"
+  pacman -S --needed --noconfirm mesa vulkan-tools || true
 fi
