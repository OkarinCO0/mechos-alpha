diff --git a/.github/workflows/test-actions.yml b/.github/workflows/test-actions.yml
index 69f55eb..7ff842d 100644
--- a/.github/workflows/test-actions.yml
+++ b/.github/workflows/test-actions.yml
@@ -59,6 +59,7 @@ jobs:
           cat >> /workspace/archlive/packages.x86_64 << "PKGS"
           plasma-meta
           sddm
+          plymouth
           konsole
           dolphin
           ark
@@ -135,6 +136,53 @@ jobs:
             rsync -aHAX --numeric-ids /workspace/overlay/rootfs/ /workspace/archlive/airootfs/
           fi
 
+          # ---------- PLYMOUTH BOOT SPLASH ----------
+          # The overlay ships the "mechos" plymouth theme (script + images), but
+          # nothing was ever telling mkinitcpio to include the plymouth hook or
+          # telling plymouth which theme to use. Without both of these the theme
+          # files just sit on disk unused and the boot splash is whatever the
+          # default Arch/archiso boot looks like. Fix both here.
+
+          # 1. Tell plymouth which theme is active (write config directly rather
+          #    than shelling out to plymouth-set-default-theme, since that tool
+          #    expects to run against a live system, not a cross-built airootfs).
+          mkdir -p /workspace/archlive/airootfs/etc/plymouth
+          cat > /workspace/archlive/airootfs/etc/plymouth/plymouthd.conf << "EOF"
+          [Daemon]
+          Theme=mechos
+          EOF
+
+          # 2. Make sure the plymouth hook is present in every mkinitcpio config
+          #    archiso will use to build the initramfs (modern archiso profiles
+          #    keep this under mkinitcpio.conf.d/, older ones under mkinitcpio.conf
+          #    directly), inserted right after the base/udev hooks so early KMS
+          #    still works.
+          for f in /workspace/archlive/airootfs/etc/mkinitcpio.conf \
+                   /workspace/archlive/airootfs/etc/mkinitcpio.conf.d/*.conf; do
+            [ -f "$f" ] || continue
+            grep -q "plymouth" "$f" && continue
+            sed -i -E "s/^(HOOKS=\([^)]*\bsystemd\b)/\1 plymouth/; t; s/^(HOOKS=\([^)]*\budev\b)/\1 plymouth/" "$f"
+          done
+
+          # ---------- DEFAULT WALLPAPER / LOOK-AND-FEEL ----------
+          # Same story as the boot splash: 19 wallpapers ship in the overlay but
+          # nothing ever pointed Plasma at one, so it just showed default Breeze.
+          mkdir -p /workspace/archlive/airootfs/etc/skel/.config
+          cat > /workspace/archlive/airootfs/etc/skel/.config/kdeglobals << "EOF"
+          [Wallpaper]
+          Image=/usr/share/backgrounds/mechos/mechos-wallpaper-01.jpg
+          EOF
+          mkdir -p /workspace/archlive/airootfs/usr/share/plasma/look-and-feel/org.mechos.desktop/contents/defaults
+          cat > /workspace/archlive/airootfs/etc/xdg/plasmarc << "EOF"
+          [Theme]
+          name=breeze-dark
+          EOF
+          # Also seed the live "mechos" user's own home (created later below) so
+          # autologin doesn't fall back to a themeless default profile.
+          mkdir -p /workspace/archlive/airootfs/home/mechos/.config
+          cp /workspace/archlive/airootfs/etc/skel/.config/kdeglobals \
+             /workspace/archlive/airootfs/home/mechos/.config/kdeglobals
+
           # ---------- GUARANTEED CREATOR MODE ----------
           mkdir -p /workspace/archlive/airootfs/usr/local/bin
           mkdir -p /workspace/archlive/airootfs/usr/share/applications
@@ -315,11 +363,17 @@ jobs:
           EOF
 
           # ---------- ARCH / LIVE DESKTOP DEFAULTS ----------
+          # NOTE: session choice (mechscope.desktop) is owned by the overlay's
+          # /etc/sddm.conf.d/10-mechos-session.conf. Do NOT set [Autologin] Session=
+          # here again — sddm.conf.d files load alphabetically and a later file
+          # here would silently win and stomp the MechScope autologin, which is
+          # exactly the "boots into plain Plasma" bug this fixes. We still need a
+          # conf file for the User/Relogin keys, so we scope it narrowly and never
+          # touch Session.
           mkdir -p /workspace/archlive/airootfs/etc/sddm.conf.d
-          cat > /workspace/archlive/airootfs/etc/sddm.conf.d/mechos.conf << "EOF"
+          cat > /workspace/archlive/airootfs/etc/sddm.conf.d/20-mechos-autologin-user.conf << "EOF"
           [Autologin]
           User=mechos
-          Session=plasma.desktop
           Relogin=true
           EOF
 
