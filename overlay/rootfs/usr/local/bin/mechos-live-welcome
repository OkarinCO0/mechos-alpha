#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/local/lib/mechos/runtime.sh
mechos_is_live || exit 0

# The disposable Live ISO has no normal installed-user password workflow.
# Disable Plasma's automatic lock screen only for the Live session so users
# cannot be stranded behind an unlock prompt. Installed MechOS is unaffected.
disable_live_lockscreen() {
  mkdir -p "$HOME/.config"

  if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock false || true
    kwriteconfig6 --file kscreenlockerrc --group Daemon --key LockOnResume false || true
    kwriteconfig6 --file kscreenlockerrc --group Daemon --key Timeout 0 || true
  else
    cat > "$HOME/.config/kscreenlockerrc" <<'LOCK_EOF'
[Daemon]
Autolock=false
LockOnResume=false
Timeout=0
LOCK_EOF
  fi

  chmod 600 "$HOME/.config/kscreenlockerrc" 2>/dev/null || true

  # Plasma 6 commonly exposes KScreenLocker as this user service. Mask it only
  # for the current Live boot; --runtime disappears automatically at reboot.
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user stop plasma-kscreenlocker.service >/dev/null 2>&1 || true
    systemctl --user mask --runtime plasma-kscreenlocker.service >/dev/null 2>&1 || true
  fi

  # If Plasma already activated the screen-saver interface during startup,
  # request the unlocked/inactive state before showing the MechOS welcome UI.
  if command -v qdbus6 >/dev/null 2>&1; then
    qdbus6 org.freedesktop.ScreenSaver /ScreenSaver \
      org.freedesktop.ScreenSaver.SetActive false >/dev/null 2>&1 || true
  elif command -v qdbus >/dev/null 2>&1; then
    qdbus org.freedesktop.ScreenSaver /ScreenSaver \
      org.freedesktop.ScreenSaver.SetActive false >/dev/null 2>&1 || true
  fi
}

disable_live_lockscreen

# Do not reopen repeatedly during the same live login unless manually launched.
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
SEEN="$RUNTIME_DIR/mechos-welcome-shown"
[[ -e "$SEEN" && "${1:-}" != "--force" ]] && exit 0
touch "$SEEN"

sleep 2

while true; do
  if command -v kdialog >/dev/null 2>&1; then
    choice="$(kdialog --title 'Welcome to MechOS' --menu \
      'Choose how you want to use MechOS. No terminal commands are required.' \
      install 'Install MechOS to this computer' \
      desktop 'Try MechOS Desktop Mode' \
      gaming 'Start MechScope Gaming Mode' \
      shutdown 'Shut Down' 2>/dev/null || true)"
  else
    choice="$(zenity --list --title='Welcome to MechOS' \
      --text='Choose how you want to use MechOS. No terminal commands are required.' \
      --column='Action' --column='Description' \
      install 'Install MechOS to this computer' \
      desktop 'Try MechOS Desktop Mode' \
      gaming 'Start MechScope Gaming Mode' \
      shutdown 'Shut Down' \
      --print-column=1 2>/dev/null || true)"
  fi

  case "$choice" in
    install)
      /usr/local/bin/mechos-install
      exit 0
      ;;
    desktop|"")
      exit 0
      ;;
    gaming)
      /usr/local/bin/mechos-session-select gaming
      exit 0
      ;;
    shutdown)
      systemctl poweroff
      exit 0
      ;;
  esac
done
