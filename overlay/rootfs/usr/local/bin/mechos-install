#!/usr/bin/env bash
set -Eeuo pipefail

source /usr/local/lib/mechos/runtime.sh

if ! mechos_is_live; then
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title 'MechOS Installer' --sorry 'Boot the MechOS USB/live image before starting the installer.'
  else
    echo 'Boot the MechOS USB/live image before starting the installer.' >&2
  fi
  exit 1
fi

if ! command -v archinstall >/dev/null 2>&1; then
  echo 'Archinstall is missing from this MechOS live image.' >&2
  exit 1
fi

if [[ "${1:-}" != "--terminal" && -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v konsole >/dev/null 2>&1; then
  exec konsole -e sudo "$0" --terminal
fi

if [[ "$(id -u)" -ne 0 ]]; then
  exec sudo "$0" --terminal
fi

CONFIG=/usr/share/mechos/install-payload/archinstall-mechos.json
if [[ -s "$CONFIG" ]]; then
  exec archinstall --config "$CONFIG"
fi

exec archinstall
