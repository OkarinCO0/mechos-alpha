#!/usr/bin/env bash
set -Eeuo pipefail

source /usr/local/lib/mechos/runtime.sh
mechos_is_live && exit 0

if [[ "$(id -u)" -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

STATE=/var/lib/mechos
MARKER="$STATE/firstboot.done"
mkdir -p "$STATE" /var/log
[[ -e "$MARKER" ]] && exit 0

systemctl enable NetworkManager.service 2>/dev/null || true
systemctl enable bluetooth.service 2>/dev/null || true
systemctl enable fstrim.timer 2>/dev/null || true
systemctl enable irqbalance.service 2>/dev/null || true
systemctl enable power-profiles-daemon.service 2>/dev/null || true
systemctl enable switcheroo-control.service 2>/dev/null || true

/usr/local/bin/mechos-gpu-setup --apply > /var/log/mechos-gpu-setup.log 2>&1 || true
plymouth-set-default-theme -R mechos 2>/dev/null || true

TARGET_USER="$(awk -F: '$3 >= 1000 && $3 < 60000 && $6 ~ /^\/home\// {print $1; exit}' /etc/passwd)"
if [[ -n "$TARGET_USER" ]]; then
  TARGET_GROUP="$(id -gn "$TARGET_USER")"
  MODE_DIR="/home/$TARGET_USER/.config/mechos"
  install -d -o "$TARGET_USER" -g "$TARGET_GROUP" "$MODE_DIR"

  if command -v steam >/dev/null 2>&1 && command -v gamescope >/dev/null 2>&1; then
    printf 'gaming\n' > "$MODE_DIR/session-mode"
  else
    printf 'desktop\n' > "$MODE_DIR/session-mode"
  fi
  chown "$TARGET_USER:$TARGET_GROUP" "$MODE_DIR/session-mode"

  SESSION=mechscope.desktop
  [[ -f /usr/share/wayland-sessions/mechos-gaming.desktop ]] && SESSION=mechos-gaming.desktop
  mkdir -p /etc/sddm.conf.d
  cat > /etc/sddm.conf.d/90-mechos-installed.conf <<SDDMEOF
[Autologin]
User=$TARGET_USER
Session=$SESSION
Relogin=true
SDDMEOF
fi

touch "$MARKER"
echo 'MechOS first-boot setup complete.'
