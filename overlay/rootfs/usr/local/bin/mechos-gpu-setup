#!/usr/bin/env bash
set -Eeuo pipefail

APPLY=0
[[ "${1:-}" == "--apply" ]] && APPLY=1

GPU_LINES="$(lspci -nnk 2>/dev/null | grep -A3 -Ei 'VGA|3D|Display' || true)"
VENDORS=()
PACKAGES=(vulkan-tools gamescope)

add_vendor() {
  local vendor="$1"
  local item
  for item in "${VENDORS[@]:-}"; do
    [[ "$item" == "$vendor" ]] && return 0
  done
  VENDORS+=("$vendor")
}

if grep -qi nvidia <<<"$GPU_LINES"; then
  add_vendor nvidia
  PACKAGES+=(nvidia-open nvidia-utils lib32-nvidia-utils nvidia-prime)
fi
if grep -Eqi 'AMD|ATI|Advanced Micro Devices' <<<"$GPU_LINES"; then
  add_vendor amd
  PACKAGES+=(mesa lib32-mesa vulkan-radeon lib32-vulkan-radeon libva-mesa-driver)
fi
if grep -qi intel <<<"$GPU_LINES"; then
  add_vendor intel
  PACKAGES+=(mesa lib32-mesa vulkan-intel lib32-vulkan-intel intel-media-driver)
fi

# De-duplicate the union of packages. Hybrid systems intentionally receive the
# userspace stack for every detected GPU instead of only the first vendor.
declare -A SEEN=()
UNIQUE_PACKAGES=()
for pkg in "${PACKAGES[@]}"; do
  [[ -n "${SEEN[$pkg]:-}" ]] && continue
  SEEN[$pkg]=1
  UNIQUE_PACKAGES+=("$pkg")
done

echo 'MechOS universal GPU setup'
echo "Detected vendors: ${VENDORS[*]:-unknown}"
printf '%s\n' "${GPU_LINES:-No display adapter detected}"

if command -v vulkaninfo >/dev/null 2>&1; then
  echo
  echo 'Vulkan summary:'
  timeout 5s vulkaninfo --summary 2>&1 | head -n 120 || true
fi

if [[ -r /sys/module/nvidia_drm/parameters/modeset ]]; then
  echo "NVIDIA DRM modeset: $(cat /sys/module/nvidia_drm/parameters/modeset 2>/dev/null || true)"
fi

[[ "$APPLY" -eq 1 ]] || exit 0

source /usr/local/lib/mechos/runtime.sh
if mechos_is_live; then
  echo 'Live ISO detected; bundled AMD/Intel/NVIDIA drivers were not changed.'
  exit 0
fi

[[ "${#VENDORS[@]}" -gt 0 ]] || {
  echo 'No supported AMD, Intel, or NVIDIA GPU was detected.' >&2
  exit 1
}

if [[ "$(id -u)" -ne 0 ]]; then
  exec sudo "$0" --apply
fi

pacman -Syu --needed --noconfirm "${UNIQUE_PACKAGES[@]}"

if [[ " ${VENDORS[*]} " == *' nvidia '* ]]; then
  install -d -m 755 /etc/modprobe.d
  cat > /etc/modprobe.d/90-mechos-nvidia-drm.conf <<'EOF'
# Required for reliable Gamescope/KMS operation on the proprietary NVIDIA stack.
options nvidia_drm modeset=1
EOF
  echo 'NVIDIA DRM/KMS is configured for the next module load/reboot.'
fi

echo "GPU packages updated for: ${VENDORS[*]}."
echo 'MechOS will automatically choose the preferred Gamescope Vulkan device at launch.'
