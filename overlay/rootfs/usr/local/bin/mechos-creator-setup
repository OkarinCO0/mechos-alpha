#!/usr/bin/env bash
set -Eeuo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

pacman -Syu --needed --noconfirm \
  blender obs-studio kdenlive krita git git-lfs cmake ninja clang python python-pip flatpak

if command -v flatpak >/dev/null 2>&1; then
  flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo || true
  flatpak install -y --noninteractive flathub com.unity.UnityHub || true
fi

cat <<'MSG'
MechOS Creator Mode is prepared.
- Unity Hub is installed through Flatpak when available.
- Keep VRChat's supported Unity editor separate from newer Unity versions.
- Unreal Engine uses Epic's authorized Linux build/source workflow.
- VRChat Creator Companion remains Windows-only; MechOS does not claim native support.
- Blender, OBS Studio, Kdenlive and Krita are installed from Arch repositories.
MSG
